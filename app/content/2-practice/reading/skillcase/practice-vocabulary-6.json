          "difficulty": "B",
          "scoring_mode": "OBJECTIVE",
          "points": 1,
          "stem": "\"Das ist mir sympathisch.\" — \"sympathisch\" bedeutet:",
          "options": [
            "ich habe Mitleid (wie engl. \"sympathetic\")",
            "ich finde die Person/Sache angenehm",
            "ich stimme zu"
