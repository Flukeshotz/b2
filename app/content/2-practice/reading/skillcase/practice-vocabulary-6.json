          "capability": "language_awareness",
          "difficulty": "B",
          "scoring_mode": "OBJECTIVE",
          "points": 1,
          "stem": "\"die Konsequenz\" bedeutet im Deutschen meist:",
          "options": [
            "die Folge einer Handlung",
            "der Beweis",
            "die Beharrlichkeit (wie engl. \"consequence\" ≠ \"consistency\")"
