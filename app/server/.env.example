# Copy to .env and fill in. .env is gitignored — never commit real values.

# Postgres. Defaults to postgresql://localhost/learn_german if unset.
DATABASE_URL=
# "true" for managed Postgres (Railway/Render) that requires SSL.
DATABASE_SSL=
PORT=4000

# Azure AI Foundry — writing feedback (src/b2/model.js) and content tooling.
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_AI_DEPLOYMENT=
AZURE_AI_API_VERSION=
# Same resource key; the image pipeline and fallbacks read this name.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# Azure Speech — text-to-speech for listening audio, and pronunciation scoring.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Optional fallback LLM provider.
DEEPSEEK_API_KEY=
